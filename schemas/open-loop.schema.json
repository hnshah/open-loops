{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hnshah/open-loops/schemas/open-loop.schema.json",
  "title": "Open Loop",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "summary",
    "state",
    "status",
    "confidence",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "I owe",
        "Waiting on",
        "Response expected",
        "Decision",
        "Follow-up",
        "Prepare",
        "Dependency",
        "Watching"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "open",
        "waiting",
        "watching",
        "prepared",
        "resolved",
        "dismissed",
        "obsolete"
      ]
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "counterparty": {
      "type": [
        "string",
        "null"
      ]
    },
    "created": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "due": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "priority": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "high",
        "medium",
        "low",
        null
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "watching"
      ]
    },
    "next_step": {
      "type": [
        "string",
        "null"
      ]
    },
    "help": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "resolution_checked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
