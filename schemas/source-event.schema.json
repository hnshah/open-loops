{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hnshah/open-loops/schemas/source-event.schema.json",
  "title": "Open Loops Source Event",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "type",
    "timestamp"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "email",
        "chat",
        "calendar",
        "meeting_note",
        "file",
        "project",
        "crm",
        "other"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "author": {
      "type": [
        "string",
        "null"
      ]
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "thread_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": true
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
